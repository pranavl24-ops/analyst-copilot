{# One-page investment memo. Filled by memo/render.py and printed to PDF. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; }
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      color: #1a1a1a;
      font-size: 10.5px;
      line-height: 1.45;
      margin: 0;
    }
    .page { padding: 4mm 2mm; }
    .chart { text-align: center; margin-bottom: 6px; }
    .chart img { max-width: 100%; height: auto; }
    h1 { font-size: 17px; margin: 0 0 2px; border-bottom: 2px solid #1a1a1a; padding-bottom: 3px; }
    h2 { font-size: 12px; margin: 10px 0 3px; color: #2a3f5f; }
    p { margin: 3px 0; }
    ul { margin: 3px 0 3px 0; padding-left: 18px; }
    li { margin: 1px 0; }
    blockquote {
      margin: 0 0 8px;
      padding: 5px 9px;
      background: #f4f1ea;
      border-left: 3px solid #b7791f;
      font-size: 9px;
      color: #5a4a2a;
    }
    strong { color: #111; }
    .body { columns: 2; column-gap: 14px; }
    .body h1 { column-span: all; }
    .body blockquote { column-span: all; }
  </style>
</head>
<body>
  <div class="page">
    <div class="chart">
      <img src="{{ chart_data_uri }}" alt="Valuation football field" />
    </div>
    <div class="body">
      {{ body_html | safe }}
    </div>
  </div>
</body>
</html>
